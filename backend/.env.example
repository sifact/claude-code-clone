XAI_API_KEY=
AGENT_MODEL=grok-build-0.1
AGENT_WORKDIR=./workspace

# Optional - LangSmith tracing (this branch only). LangSmith is purely
# env-var driven: set these and every graph run gets traced automatically,
# no code changes needed. Leave blank to run untraced.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nightcode-fastapi
